    "base44 android app",
    "base44 app store",
    "base44 google play",
    "base44 mobile app",
    "base44 paywall",
    "base44 revenuecat",
    "revenuecat",
    "in-app purchases",
    "in-app subscriptions",
    "iap",
    "paywall",
    "storekit",
    "google play billing",
    "app store",
    "google play",
    "despia",
    "no-code",
    "low-code",
    "convert web app to mobile app",
    "entitlements",
    "subscription app",
    "monetize app",
    "free trial",
    "introductory offers",
    "promotional offers",
    "subscription paywall"
  ],
  "license": "Apache-2.0",
  "author": "Despia <developers@despia.com> (https://despia.com)",
  "homepage": "https://despia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/despia-native/base44-revenuecat.git"
  },
  "bugs": {
    "url": "https://github.com/despia-native/base44-revenuecat/issues"
  },
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./server.mjs",
      "require": "./server.cjs",
      "default": "./server.mjs"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "server.cjs",
    "server.mjs",
    "server.d.ts",
    "README.md",
